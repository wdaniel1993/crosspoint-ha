{
  "title": "Home Assistant",
  "token": {
    "file": "/.crosspoint/homeassistant.json",
    "path": "token"
  },
  "config": {
    "file": "/.crosspoint/homeassistant.json"
  },
  "browse": {
    "format": "json",
    "url": "{cfg.url}/api/services/script/crosspoint_ha_catalog?return_response",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {token}"
    },
    "body": "{\"page\": {page}, \"limit\": {limit}}",
    "items": "service_response.items",
    "fields": {
      "title": "t",
      "author": "a",
      "id": "i",
      "url": "u"
    },
    "page_size": 12,
    "lists": [
      { "title": "Scenes", "body": "{\"page\": {page}, \"limit\": {limit}, \"kind\": \"scene\"}" },
      { "title": "Scripts", "body": "{\"page\": {page}, \"limit\": {limit}, \"kind\": \"script\"}" },
      { "title": "All entities" }
    ],
    "search": {
      "body": "{\"page\": {page}, \"limit\": {limit}, \"query\": \"{query_raw}\"}"
    }
  },
  "download": {
    "url": "{cfg.url}/api/services/script/crosspoint_ha_catalog?return_response",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {token}"
    },
    "body": "{\"act\": \"{id}\", \"base\": \"{cfg.url}\"}",
    "url_path": "service_response.ack",
    "dest_dir": "/ha",
    "filename": "ack.json"
  }
}
